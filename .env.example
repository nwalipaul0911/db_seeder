# Flask application
FLASK_DEBUG=0

# Run retention and logging
SEEDER_MAX_RUNS=100
SEEDER_LOG_LEVEL=INFO

# S3 run storage. Leave SEEDER_S3_BUCKET empty to use local uploads/runs.
SEEDER_S3_BUCKET=sample-bucket
SEEDER_S3_PREFIX=sample-prefix

# AWS SDK settings
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=sample-access-key-id
AWS_SECRET_ACCESS_KEY=sample-secret-access-key
